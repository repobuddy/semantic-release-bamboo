{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>unional/renovate-preset"],
	"platformAutomerge": true,
	"packageRules": [
		{
			"description": "Dev-only updates merge themselves once CI is green.",
			"matchDepTypes": ["devDependencies", "packageManager"],
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"automerge": true
		},
		{
			"description": "GitHub Actions minor/patch updates merge themselves.",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"automerge": true
		},
		{
			"description": "Runtime dependencies ship to consumers, so they stay manual.",
			"matchDepTypes": ["dependencies", "peerDependencies"],
			"automerge": false
		},
		{
			"description": "Majors stay manual regardless of dep type.",
			"matchUpdateTypes": ["major"],
			"automerge": false
		}
	]
}
