{
	"name": "semantic-release-bamboo",
	"version": "0.1.4",
	"description": "semantic-release plugin for Bamboo",
	"homepage": "https://github.com/repobuddy/semantic-release-bamboo",
	"bugs": {
		"url": "https://github.com/repobuddy/semantic-release-bamboo/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/semantic-release-bamboo.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"ts",
		"!ts/**/*.spec.ts"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "rimraf dist",
		"coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"cs": "changeset",
		"depcheck": "depcheck",
		"nuke": "pnpm clean && rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"verify": "npm-run-all clean -p build check coverage depcheck",
		"version": "changeset version",
		"watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch"
	},
	"dependencies": {
		"@semantic-release/error": "^4.0.0",
		"env-ci": "^11.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "^2.3.1",
		"@types/jest": "30.0.0",
		"@types/node": "^26.2.0",
		"depcheck": "^1.4.3",
		"husky": "^9.0.0",
		"jest": "30.4.2",
		"jest-validate": "30.4.1",
		"jest-watch-suspend": "^1.1.2",
		"jest-watch-toggle-config": "^3.0.0",
		"jest-watch-typeahead": "^3.0.0",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"ts-jest": "^29.0.0",
		"typedoc": "^0.28.0",
		"typedoc-plugin-extras": "^4.0.0",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
